{
    "name": "mbpcoder/php-iran-payment",
    "description": "Framework-agnostic PHP payment package for Iranian payment gateways (Zarinpal, IDPay, Pay.ir, Jibit, Sep, PayPing, Bahamta, PayStar) with Laravel and Symfony integrations.",
    "type": "library",
    "keywords": ["payment", "iran", "gateway", "zarinpal", "idpay", "jibit", "laravel", "symfony"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel integration (service provider & facade).",
        "symfony/http-kernel": "Required to use the Symfony bundle integration."
    },
    "autoload": {
        "psr-4": {
            "MbpCoder\\IranPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MbpCoder\\IranPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MbpCoder\\IranPayment\\Laravel\\IranPaymentServiceProvider"
            ],
            "aliases": {
                "IranPayment": "MbpCoder\\IranPayment\\Laravel\\IranPaymentFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
