{
    "name": "mbpcoder/php-payment",
    "description": "Framework-agnostic PHP payment package for payment gateways (Zarinpal, IDPay, Pay.ir, Jibit, Sep, PayPing, Bahamta, PayStar) with Laravel and Symfony integrations.",
    "type": "library",
    "keywords": ["payment", "gateway", "zarinpal", "idpay", "jibit", "laravel", "symfony"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "illuminate/support": "^11.0 || ^12.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel integration (service provider & facade).",
        "symfony/http-kernel": "Required to use the Symfony bundle integration.",
        "ext-soap": "Required for SOAP-based gateways (BehPardakht, PEC)."
    },
    "autoload": {
        "psr-4": {
            "MbpCoder\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MbpCoder\\Payment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MbpCoder\\Payment\\Laravel\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "MbpCoder\\Payment\\Laravel\\PaymentFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
